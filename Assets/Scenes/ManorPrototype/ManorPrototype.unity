MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1778529308}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: winch.instructions
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438 \u0440\u0443\u043A\u0456\u0432\u2019\u044F. \u0423\u0442\u0440\u0438\u043C\u0443\u0439 Space \u0434\u043E \u043F\u043E\u0434\u0432\u0456\u0439\u043D\u043E\u0433\u043E \u043A\u043B\u0430\u0446\u0430\u043D\u043D\u044F. \u0412\u0456\u0434\u043F\u0443\u0441\u0442\u0438, \u0449\u043E\u0431 \u0441\u0442\u043E\u043F\u043E\u0440 \u0441\u0456\u0432 \u0443 \u043F\u0430\u0437.\n\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u0456 \u0442\u0440\u0438 \u0446\u0438\u043A\u043B\u0438; \u0432\u0456\u043A\u043D\u043E \u0440\u0435\u0430\u043A\u0446\u0456\u0457 \u2014 1,5 \u0441\u0435\u043A\u0443\u043D\u0434\u0438. \u0412\u0436\u0435 \u0437\u0430\u0444\u0456\u043A\u0441\u043E\u0432\u0430\u043D\u0456 \u0441\u0442\u0443\u043F\u0435\u043D\u0456 \u043D\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F. Escape \u2014 \u0432\u0456\u0434\u0456\u0439\u0442\u0438."
  fullTextFlag: 
  fullText: 
  frequency: 0
  radioChannel: {fileID: 0}
