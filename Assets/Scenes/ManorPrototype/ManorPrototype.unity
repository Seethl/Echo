--- !u!114 &1710337076
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1710337075}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: gallery.card
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430: {frequency}.\n\xAB\u041A\u043E\u0434 \u043F\u0440\u043E\u0445\u043E\u0434\u0443: \u0447\u043E\u0442\u0438\u0440\u0438\u2026 [\u0433\u0443\u0440\u043A\u0456\u0442 \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u0454 \u0440\u0435\u0448\u0442\u0443]\xBB.\n\u0413\u0456\u043B\u043A\u0430 \u0437\u0430\u0432\u0430\u0436\u0430\u0454 \u0437\u0430\u0444\u0456\u043A\u0441\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u043A\u043E\u043D\u043D\u0438\u0446\u044E. \u041F\u0440\u0438\u0431\u0435\u0440\u0456\u0442\u044C \u0433\u0456\u043B\u043A\u0443, \u0437\u0430\u043A\u0440\u0438\u0439\u0442\u0435 \u0432\u0456\u043A\u043E\u043D\u043D\u0438\u0446\u044E \u0442\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C \u0437\u0430\u043F\u0438\u0441 \u0430\u0431\u043E \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u044C\u0442\u0435 \u0446\u044E \u043A\u0430\u0440\u0442\u043A\u0443."
  fullTextFlag: gallery.quiet
  fullText: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 {frequency}: \xAB\u041A\u043E\u0434 \u043F\u0440\u043E\u0445\u043E\u0434\u0443: 4 \u2014 1 \u2014 7\xBB. \u041F\u0456\u0441\u043B\u044F \u0442\u0438\u0448\u0456 \u0432\u043B\u0430\u0441\u043D\u0456 \u043A\u0440\u043E\u043A\u0438 \u0447\u0443\u0442\u043D\u0456\u0448\u0456. \u0423 \u0445\u043E\u043B\u0456 \u0440\u0443\u0445\u0430\u0439\u0442\u0435\u0441\u044F \u043A\u0438\u043B\u0438\u043C\u043E\u043C \u0456 \u0437\u0430 \u0443\u043A\u0440\u0438\u0442\u0442\u044F\u043C\u0438."
  frequency: 940
  radioChannel: {fileID: 11400000, guid: 8ee00270776942e45afc6495dc10981e, type: 2}
