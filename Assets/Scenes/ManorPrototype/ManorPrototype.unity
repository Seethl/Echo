  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: gallery.card
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430: 940. \u0413\u0443\u0440\u043A\u0456\u0442 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0445 \u0432\u0456\u043A\u043E\u043D\u043D\u0438\u0446\u044C \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u0454 \u0446\u0438\u0444\u0440\u0438.\n\u0417\u0430\u0447\u0438\u043D\u0438 \u0432\u0441\u0456 \u0442\u0440\u0438 \u0432\u0456\u043A\u043D\u0430 \u0432 \u0433\u0430\u043B\u0435\u0440\u0435\u0457 \u0442\u0430 \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0441\u043B\u0443\u0445\u0430\u0439 \u0440\u0430\u0434\u0456\u043E. R \u2014 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438; F \u2014 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F; J \u2014 \u0437\u0430\u043F\u0438\u0441\u0438."
  fullTextFlag:
  fullText:
  frequency: 940
  radioChannel: {fileID: 11400000, guid: 8ee00270776942e45afc6495dc10981e, type: 2}
  illustration: {fileID: 0}
  onReadFlag:
