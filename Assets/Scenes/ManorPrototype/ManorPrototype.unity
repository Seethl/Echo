--- !u!114 &1746656305
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1746656303}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: remedy.recipe
  title: "\u0420\u0415\u0426\u0415\u041F\u0422 \u041C\u0406\u041A\u0421\u0422\u0423\u0420\u0418"
  text: "\u041E\u0441\u043D\u043E\u0432\u0430 \u2014 \u0443 \u0448\u0430\u0444\u0446\u0456 \u043D\u0430 \u043A\u0443\u0445\u043D\u0456; \u043A\u043B\u044E\u0447 \u2014 \u043D\u0430\u0433\u043E\u0440\u0456.\n\u041A\u0432\u0456\u0442\u043A\u0430: \u043F\u2019\u044F\u0442\u044C \u0431\u043B\u0456\u0434\u0438\u0445 \u043F\u0435\u043B\u044E\u0441\u0442\u043E\u043A, \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0456 \u043B\u0438\u0441\u0442\u043A\u0438. \u041A\u043B\u0443\u043C\u0431\u0438 \u043D\u0430\u0434\u0432\u043E\u0440\u0456; \u0433\u0435\u0440\u0431\u0430\u0440\u0456\u0439 \u2014 \u0443 \u0441\u0430\u0434\u0456\u0432\u043D\u0438\u0447\u0456\u0439.\n\u041D\u0430\u043B\u0438\u0439 \u043E\u0441\u043D\u043E\u0432\u0443, \u0434\u043E\u0434\u0430\u0439 \u043A\u0432\u0456\u0442\u043A\u0443, \u0440\u043E\u0437\u043C\u0456\u0448\u0430\u0439 \u0441\u0440\u0456\u0431\u043D\u043E\u044E \u043B\u043E\u0436\u0435\u0447\u043A\u043E\u044E \u0437 \u0445\u043E\u043B\u0443.\n\u0417\u0430\u043B\u0438\u0448 \u0443 \u0439\u043E\u0433\u043E \u0447\u0430\u0448\u0446\u0456 \u0442\u0430 \u0432\u0456\u0434\u0456\u0439\u0434\u0438."
  fullTextFlag:
  fullText:
  frequency: 0
  radioChannel: {fileID: 0}
  illustration: {fileID: 0}
  onReadFlag: remedy.recipe.read
