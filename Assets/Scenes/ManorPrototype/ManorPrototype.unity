  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: service.card
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430: {frequency}. \u0417\u0430\u043F\u0430\u0441\u043D\u0438\u0439 \u043A\u043B\u044E\u0447 \u0432\u0456\u0434 \u0441\u043B\u0443\u0436\u0431\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0443 \u2014 \u0443 \u0448\u0430\u0444\u0446\u0456 \u0431\u0456\u043B\u044F \u0434\u0432\u0435\u0440\u0435\u0439.\n\u0420\u0430\u0434\u0456\u043E: R \u2014 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438; F \u2014 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F; Q \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438. \u0411\u0435\u0437 \u0432\u0438\u0442\u0440\u0430\u0442\u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u0439\u043E\u043A."
  fullTextFlag: 
  fullText: 
  frequency: 820
  radioChannel: {fileID: 11400000, guid: c8d7f726d6dd2b44b9c1ccb92479c9db, type: 2}
