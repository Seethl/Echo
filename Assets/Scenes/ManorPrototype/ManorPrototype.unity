--- !u!114 &309466767
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 309466765}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: garden.herbarium
  title: "\u0413\u0415\u0420\u0411\u0410\u0420\u0406\u0419 \u0421\u0410\u0414\u0406\u0412\u041D\u0418\u041A\u0410"
  text: "\u0414\u043B\u044F \u043C\u0456\u043A\u0441\u0442\u0443\u0440\u0438: \u043F\u2019\u044F\u0442\u044C \u0431\u043B\u0456\u0434\u0438\u0445 \u043F\u0435\u043B\u044E\u0441\u0442\u043E\u043A, \u0434\u0432\u0430 \u043B\u0438\u0441\u0442\u043A\u0438 \u043D\u0430\u0432\u043F\u0440\u043E\u0442\u0438 \u043E\u0434\u043D\u0435 \u043E\u0434\u043D\u043E\u0433\u043E. \u041A\u043B\u0443\u043C\u0431\u0430 \u043D\u0430\u0434\u0432\u043E\u0440\u0456.\n\u0421\u0438\u043D\u0456 \u043A\u0432\u0456\u0442\u0438 \u043C\u0430\u044E\u0442\u044C \u0448\u0456\u0441\u0442\u044C \u043F\u0435\u043B\u044E\u0441\u0442\u043E\u043A; \u0436\u043E\u0432\u0442\u0456 \u2014 \u0442\u0440\u0438. \u0412\u043E\u043D\u0438 \u043D\u0435 \u043F\u0456\u0434\u0445\u043E\u0434\u044F\u0442\u044C.\n\u0420\u043E\u0441\u043B\u0438\u043D\u0438 \u043C\u043E\u0436\u043D\u0430 \u043E\u0433\u043B\u044F\u0434\u0430\u0442\u0438; \u043F\u043E\u043C\u0438\u043B\u043A\u0430 \u043D\u0435 \u043F\u0441\u0443\u0454 \u0437\u0456\u0431\u0440\u0430\u043D\u0435."
  fullTextFlag:
  fullText:
  frequency: 0
  radioChannel: {fileID: 0}
  illustration: {fileID: 0}
  onReadFlag: garden.herbarium.read
