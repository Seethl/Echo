  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: library.card
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0421\u043B\u0443\u0436\u0431\u043E\u0432\u0438\u0439 \u0437\u0430\u043F\u0438\u0441: {frequency}.\n\u0414\u0432\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0456 \u2192 \u043E\u0434\u0438\u043D \u0434\u043E\u0432\u0433\u0438\u0439 \u2192 \u0442\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0456.\n\u041F\u043E\u0441\u043B\u0443\u0445\u0430\u0439\u0442\u0435 \u043D\u0430\u0441\u0442\u0456\u043D\u043D\u0456 \u043F\u0430\u043D\u0435\u043B\u0456, \u0449\u043E\u0431 \u0437\u0456\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0440\u0438\u0442\u043C\u0438 \u0456\u0437 \u0441\u0438\u043C\u0432\u043E\u043B\u0430\u043C\u0438. \u041F\u0456\u0441\u043B\u044F \u043F\u043E\u043C\u0438\u043B\u043A\u0438 \u0441\u043A\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u043B\u0438\u0448\u0435 \u043F\u043E\u0442\u043E\u0447\u043D\u0438\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A."
  fullTextFlag: 
  fullText: 
  frequency: 1060
  radioChannel: {fileID: 11400000, guid: caf5a438f606ddf4f868be26064f848a, type: 2}
