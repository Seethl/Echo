  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: library.card
  title: "\u0421\u041B\u0423\u0416\u0411\u041E\u0412\u0410 \u041A\u0410\u0420\u0422\u041A\u0410"
  text: "\u0424\u043E\u043D\u043E\u0442\u0435\u043A\u0430: {frequency}.\n\u0414\u043E\u0441\u043B\u0443\u0445\u0430\u0439 \u0437\u0432\u0443\u043A\u0438 \u0442\u0432\u0430\u0440\u0438\u043D \u043D\u0430 \u0440\u0430\u0434\u0456\u043E \u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u0438 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043D\u0430 \u0432\u0456\u043D\u0456\u043B\u043E\u0432\u0438\u0445 \u043F\u043B\u0430\u0442\u0456\u0432\u043A\u0430\u0445 \u0441\u0445\u043E\u0432\u0430\u043D\u043A\u0438. \u041A\u043E\u0436\u043D\u0430 \u043F\u043B\u0430\u0442\u0456\u0432\u043A\u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u044E\u0454 \u0441\u0432\u0456\u0439 \u0437\u0432\u0443\u043A.\nR \u2014 \u043F\u043E\u0432\u0442\u043E\u0440 \u0437\u0430\u043F\u0438\u0441\u0443; J \u2014 \u043F\u043E\u0447\u0443\u0442\u0456 \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0438."
  fullTextFlag:
  fullText:
  frequency: 1060
  radioChannel: {fileID: 11400000, guid: caf5a438f606ddf4f868be26064f848a, type: 2}
  illustration: {fileID: 0}
  onReadFlag:
