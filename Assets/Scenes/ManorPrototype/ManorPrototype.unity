  m_Script: {fileID: 11500000, guid: e072b02efc18ccb4db44478f6463a435, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::Echo.Manor.ClueNote
  clueId: study.photo
  title: "\u0421\u0422\u0410\u0420\u0410 \u0424\u041E\u0422\u041E\u0413\u0420\u0410\u0424\u0406\u042F"
  text: "\u041D\u0430 \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0444\u043E\u0442\u043E \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0437 \u043C\u0456\u0441\u044F\u0446\u0435\u043C \u0432\u0456\u0434\u0441\u0443\u043D\u0443\u0442\u0430 \u0432\u0456\u0434 \u0442\u0435\u043C\u043D\u043E\u0457 \u043D\u0456\u0448\u0456. \u0417\u0430\u0440\u0430\u0437 \u0432\u043E\u043D\u0430 \u0437\u0430\u043A\u0440\u0438\u0432\u0430\u0454 \u0446\u0435 \u043C\u0456\u0441\u0446\u0435.\n\u0422\u0443\u0442 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E. \u0414\u0432\u0435\u0440\u0456 \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u0447\u0438\u043D\u0438\u0442\u0438."
  fullTextFlag:
  fullText:
  frequency: 0
  radioChannel: {fileID: 0}
